import java.util.Scanner;

public class SubsetSum {

    static int[] set;
    static int target;
    static int n;

    static boolean subsetSum(int index, int sum) {

        // Target found
        if (sum == target)
            return true;

        // End of array or sum exceeded
        if (index >= n || sum > target)
            return false;

        // Include current element
        if (subsetSum(index + 1, sum + set[index]))
            return true;

        // Exclude current element
        return subsetSum(index + 1, sum);
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of elements: ");
        n = sc.nextInt();

        set = new int[n];

        System.out.println("Enter elements:");

        for (int i = 0; i < n; i++) {
            set[i] = sc.nextInt();
        }

        System.out.print("Enter target sum: ");
        target = sc.nextInt();

        boolean result = subsetSum(0, 0);

        if (result)
            System.out.println("Subset exists");
        else
            System.out.println("Subset does not exist");

        System.out.println("Time Complexity: O(2^n)");
        System.out.println("Space Complexity: O(n)");
    }
}
